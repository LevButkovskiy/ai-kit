{
  "description": "Auto-format edited files and enforce commit gates",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/scripts/format.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/scripts/gate.sh",
            "timeout": 300,
            "statusMessage": "Running commit gates..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *--no-verify*)",
            "command": "echo 'Bypassing commit gates is not allowed. Fix the failures instead.' >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/.claude/gates.json)",
            "command": "echo 'gates.json is owned by the developer, not the agent. Ask the user to change it.' >&2; exit 2"
          }
        ]
      }
    ]
  }
}
